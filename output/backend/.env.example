# Copy this to .env and fill in your values
# NEVER commit .env to Git — rotate any keys that were already exposed

PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# MySQL (use a cloud DB: PlanetScale / Railway / Aiven)
DB_HOST=your-cloud-mysql-host
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=eauction
DB_DIALECT=mysql
DB_PORT=3306

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# PayPal (rotate these — they were exposed)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_API=https://api-m.sandbox.paypal.com

# Groq AI (rotate this — it was exposed)
GROQ_API_KEY=your-groq-api-key

# Cloudinary (sign up at cloudinary.com — free tier)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS — your Vercel frontend URL
FRONTEND_URL=https://your-frontend.vercel.app

# Vercel Cron protection secret (any random string)
CRON_SECRET=some-random-secret-string-here
